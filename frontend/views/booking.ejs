<!DOCTYPE html>
<html lang="tr">
<%- include('./partials/head.ejs') %> 
<body>

<%- include('./partials/nav.ejs') %>

 <div class="container">
   <h6 class="center-align" style="margin-top: 60px"><span class="soon">Temizlik randevunuzu planlayın</span></h6>
</div> 

<div class="valign-wrapper" style="margin-top: 60px;">
 <div class="row">
    <form method="POST" action="/getDate" class="col s12">

      <div class="row">
        <div class="input-field col s12">
        <input id="date" type="text" name="date" class="datepicker center-align col s12" placeholder="Tarih seçin">
        </div>
      </div>
      <div class="row">
        <div class="input-field col s6">
        <i class="material-icons prefix">account_circle</i>
          <input id="first_name" type="text" class="validate" name="first">
          <label for="first_name">Ad</label>
        </div>
        <div class="input-field col s6">
        <i class="material-icons prefix">account_circle</i>
          <input id="last_name" type="text" class="validate" name="last">
          <label for="last_name">Soyad</label>
        </div>
      </div>
    
      <div class="row">
        <div class="input-field col s6">
          <i class="material-icons prefix">phone</i>
          <input id="icon_telephone" type="tel" class="validate" name="phone">
          <label for="icon_telephone">Telefon</label>
        </div>
        <div class="input-field col s6">
        <select name="square">
         <option value="" disabled selected>Yaklaşık m²</option>
         <option value="0-100">0 - 100 m²</option>
         <option value="100-150">100 - 150 m²</option>
         <option value="150-200">150 - 200 m²</option>
         <option value="200+">200 m² ve üzeri</option>
         <option value="Other">Diğer büyüklük veya tür</option>
        </select>
        <label>Mekân büyüklüğünü seçin</label>
        </div> 
      </div> 
      
      <div class="row">
        <form class="col s12">
        <div class="row">
          <div class="input-field col s12">
          <i class="material-icons prefix">home</i>
            <textarea id="textarea1" class="materialize-textarea" name="address"></textarea>
            <label for="textarea1">Konut veya iş yeri adresi</label>
          </div>
        </div>
      </div>

      <div class="row"> 
        <div class="input-field col s12">
          <i class="material-icons prefix">email</i>
          <input id="email" type="email" class="validate" name="email">
          <label for="email">E-posta adresi</label>
          <center>Onay ve makbuz bu adrese gönderilir</center>
        </div>
      </div>
      
      <div class="row">
        <div class="input-field col s12">
          <textarea id="textarea1" class="materialize-textarea" data-length="350" name="comment"></textarea>
          <label for="textarea1">Ek notlar</label>
        </div>
      </div> 
      
      <div class="row center-align">
      <button class="waves-effect waves-light btn" type="submit" name="action">Gönder</button>
     
    </form>
  </div>
</div> 

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/js/materialize.min.js"></script> 

<%- include('./partials/scripts.ejs') %>

</body>
</html>
