<!DOCTYPE html>
<html lang="tr">
<%- include('../partials/head.ejs') %>
<body>
<%- include('../partials/nav.ejs') %>

<main class="container" style="padding-bottom: 3rem;">
  <header class="section">
    <h1 class="blue-text text-darken-3" style="font-size: 1.75rem; font-weight: 700;">İzmir temizlik hizmeti bölgeleri</h1>
    <p class="grey-text text-darken-2" style="max-width: 42rem;">
      Öncelikli bölgeler (Konak, Karşıyaka, Bornova, Buca, Gaziemir, Balçova, Çiğli, Bayraklı) listede üstte yer alır.
      Her ilçe sayfasından <a href="/hizmetler" class="blue-text text-darken-2">hizmet kategorileri</a> ile eşleşen detay ve talep bağlantılarına gidebilirsiniz.
    </p>
  </header>

  <nav class="breadcrumb" aria-label="Sayfa konumu" style="margin-bottom: 1.5rem; font-size: 14px;">
    <a href="/">Ana sayfa</a>
    <span class="grey-text"> / </span>
    <span class="grey-text text-darken-2">İzmir</span>
  </nav>

  <% var primarySet = {}; primaryDistricts.forEach(function (p) { primarySet[p.slug] = true; }); %>
  <div class="row">
    <% districts.forEach(function (d) { %>
      <div class="col s6 m4 l3">
        <div class="card-panel blue darken-1 white-text hoverable" style="margin-bottom: 12px; position: relative;">
          <% if (primarySet[d.slug]) { %>
            <span class="new badge amber darken-2" style="position: absolute; top: 8px; right: 8px;" title="Öncelikli hizmet bölgesi">Öncelikli</span>
          <% } %>
          <a href="/izmir/<%= d.slug %>" class="white-text" style="font-weight: 600; display: inline-block; padding-right: 4px;"><%= d.name %></a>
        </div>
      </div>
    <% }); %>
  </div>
</main>

<%- include('../partials/footer.ejs') %>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/js/materialize.min.js"></script>
<%- include('../partials/scripts.ejs') %>
</body>
</html>
