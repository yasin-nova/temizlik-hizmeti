<!DOCTYPE html>
<html lang="tr">
<%- include('../partials/head.ejs') %>
<body>
<%- include('../partials/nav.ejs') %>

<main class="container page-hizmet-kategori" style="padding-bottom: 3rem;">
  <article>
    <header class="section" style="padding-bottom: 0;">
      <% if (typeof groupMeta !== 'undefined' && groupMeta.title) { %>
      <p class="grey-text" style="font-size: 13px; margin-bottom: 0.35rem;"><%= groupMeta.title %></p>
      <% } %>
      <h1 class="blue-text text-darken-3" style="font-size: 1.85rem; font-weight: 700;"><%= service.name %></h1>
      <p class="grey-text text-darken-2" style="font-size: 1.05rem; font-weight: 500;"><%= service.tagline %></p>
      <p class="grey-text text-darken-2" style="max-width: 42rem; line-height: 1.7; margin-top: 1rem;">
        <%= service.intro %>
      </p>
    </header>

    <nav class="breadcrumb" aria-label="Sayfa konumu" style="margin: 1rem 0 1.5rem; font-size: 14px;">
      <a href="/">Ana sayfa</a>
      <span class="grey-text"> / </span>
      <a href="/hizmetler">Hizmetler</a>
      <span class="grey-text"> / </span>
      <span class="grey-text text-darken-2"><%= service.shortLabel %></span>
    </nav>

    <div class="section" style="padding-top: 0;">
      <h2 class="h6" style="font-weight: 600; color: var(--color-primary-dark);">Öne çıkan başlıklar</h2>
      <ul class="browser-default" style="padding-left: 1.25rem; max-width: 40rem; line-height: 1.75;">
        <% service.highlights.forEach(function (line) { %>
          <li style="margin-bottom: 0.35rem;"><%= line %></li>
        <% }); %>
      </ul>
    </div>

    <div class="section" style="padding-top: 0;">
      <h2 class="h6" style="font-weight: 600; color: var(--color-primary-dark);">İzmir’de öncelikli hizmet bölgeleri</h2>
      <p class="grey-text text-darken-2" style="font-size: 14px; max-width: 40rem;">
        Aşağıdaki ilçelerde bu kategori için doğrudan talep oluşturabilirsiniz. Sayfalar ilçe + hizmet birleşimine göre SEO için optimize edilmiştir.
      </p>
      <div class="row" style="margin-top: 0.75rem;">
        <% primaryDistricts.forEach(function (d) { %>
          <div class="col s6 m4 l3">
            <a href="/izmir/<%= d.slug %>/<%= service.slug %>" class="card-panel hoverable blue lighten-5 blue-text text-darken-3 center-align" style="display: block; border-radius: var(--radius-md); font-weight: 600; padding: 14px 10px;">
              <%= d.name %>
            </a>
          </div>
        <% }); %>
      </div>
      <p style="font-size: 13px; margin-top: 1rem;">
        <a href="/izmir" class="blue-text text-darken-2">Tüm İzmir ilçeleri →</a>
      </p>
    </div>

    <div class="section center-align" style="padding-top: 0;">
      <a href="/quote" class="waves-effect waves-light btn blue darken-2" style="margin: 4px;">Bu hizmet için teklif</a>
      <a href="/booking" class="waves-effect waves-light btn blue darken-2" style="margin: 4px;">Randevu</a>
      <a href="tel:+905355271254" class="waves-effect waves-light btn white blue-text text-darken-3" style="margin: 4px; border: 1px solid rgba(29,78,216,0.35);">
        <i class="fa-solid fa-phone"></i>&nbsp;0535 527 12 54
      </a>
    </div>
  </article>
</main>

<%- include('../partials/footer.ejs') %>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/js/materialize.min.js"></script>
<%- include('../partials/scripts.ejs') %>
</body>
</html>
